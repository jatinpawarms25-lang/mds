# Supabase Real Cloud Sync Configuration (Mac + Android)
# For NEET-MDS Top-10 Planner (Section 3A)
# Copy this file to .env or paste these values directly into Settings -> Sync Account in the App.

# Your Supabase Project URL (found in Supabase Dashboard -> Project Settings -> API)
VITE_SUPABASE_URL=https://your-project-id.supabase.co

# Your Supabase Public Anon Key (safe for client-side use; protected by Row Level Security)
# NEVER put your service_role or secret key here!
VITE_SUPABASE_ANON_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.example_public_anon_key_only
